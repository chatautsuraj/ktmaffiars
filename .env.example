# Host port for docker compose (maps to container 3000)
UI_PUBLISH_PORT=9000

# Admin panel credentials (bootstrap super-admin)
# Local development: optional (falls back to editor@ktmaffairs.com / ktm-admin-2026)
# Production: REQUIRED — server refuses auth without these
# Additional editors/managers are invited from Admin → Team access (not env vars)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Session signing secret
# Local development: optional
# Production: REQUIRED — generate with: openssl rand -base64 48
AUTH_SECRET=

# Vercel Blob — enables live CMS writes/uploads on Vercel.
# Local: leave unset to use content/*.json + public/uploads/
# Production: required for writable admin (create a Blob store in the Vercel dashboard)
BLOB_READ_WRITE_TOKEN=

# Autopilot is HALTED by default for this deployment.
# Leave as true (or unset). Set to false only when you intentionally re-enable automation.
AUTOPILOT_HALTED=true

# Optional Stripe Checkout for Professional membership ($12/mo)
# If unset, the membership page collects a waitlist request instead.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Shared secret for POST /api/autopilot/cron (unused while Autopilot is halted)
CRON_SECRET=

# LLM keys (unused while Autopilot is halted)
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
AUTOPILOT_MODEL=gpt-4o-mini
